
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Listing | Wander</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <style>
        
        body {
            background: linear-gradient(135deg, #f8f9fa, #e8f5f1);
            font-family: Arial, sans-serif;
            min-height: 100vh;
        }

        .listing-container {
            max-width: 750px;
            margin: 50px auto;
            padding: 0 15px;
        }

        .listing-card {
            background: white;
            padding: 35px;
            border-radius: 22px;
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
        }

        .brand {
            color: #198754;
            font-weight: 800;
            letter-spacing: -1px;
        }

        .form-label {
            font-weight: 600;
            color: #343a40;
        }

        .form-control {
            padding: 12px 15px;
            border-radius: 12px;
            border: 1px solid #dee2e6;
            transition: 0.2s;
        }

        .form-control:focus {
            border-color: #198754;
            box-shadow: 0 0 0 0.2rem rgba(25, 135, 84, 0.12);
        }

        textarea {
            resize: vertical;
        }

        .submit-btn {
            background: #198754;
            color: white;
            padding: 13px;
            border: none;
            border-radius: 12px;
            font-weight: 700;
            transition: 0.2s;
        }

        .submit-btn:hover {
            background: #146c43;
            color: white;
            transform: translateY(-2px);
        }

        .back-link {
            color: #198754;
            text-decoration: none;
            font-weight: 600;
        }

        .back-link:hover {
            text-decoration: underline;
        }

        @media (max-width: 576px) {
            .listing-card {
                padding: 22px;
            }

            .listing-container {
                margin: 25px auto;
            }
        }
    </style>
</head>

<body>
   <div class="listing-container">

        <a href="/listings" class="back-link">
            &larr; Back to all listings
        </a>

        <div class="listing-card mt-3">

            <div class="text-center mb-4">
                <h2 class="brand">✦ Wander</h2>
                <h3 class="fw-bold mt-3">Create a New Listing</h3>
                <p class="text-secondary">
                    Share a beautiful place with the world.
                </p>
            </div>

            <form method="POST" action="/listings">

                <div class="mb-3">
                    <label class="form-label">Listing Title</label>
                    <input
                        name="listing[title]"
                        type="text"
                        class="form-control"
                        placeholder="e.g. Cozy Beachfront Cottage"
                        required>
                </div>

                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea
                        name="listing[description]"
                        class="form-control"
                        rows="4"
                        placeholder="Describe what makes this place special..."
                        required></textarea>
                </div>

               

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Price per Night (₹)</label>
                        <input
                            name="listing[price]"
                            type="number"
                            min="0"
                            class="form-control"
                            placeholder="e.g. 2500"
                            required>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Location</label>
                        <input
                            name="listing[location]"
                            type="text"
                            class="form-control"
                            placeholder="e.g. Goa"
                            required>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label">Country</label>
                    <input
                        name="listing[country]"
                        type="text"
                        class="form-control"
                        placeholder="e.g. India"
                        required>
                </div>

                <button type="submit" class="btn submit-btn w-100">
                    + Create Listing
                </button>

            </form>

        </div>

        <p class="text-center text-secondary mt-4 small">
            Made for explorers, by Wander.
        </p>

    </div>

</body>
</html>
