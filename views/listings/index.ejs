<% layout("layouts/boilerplate") %>

<div class="container my-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0">All Listings</h3>
        <a href="/listings/new" class="btn btn-dark">
            <i class="fa-solid fa-plus me-1"></i> Create New
        </a>
    </div>

    <!-- Cards Grid -->
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-1 g-4">
        <% for (let listing of allLi) { %>
            <div class="col">
                <div class="card listing-card shadow-sm h-100">
                    
                    <!-- Listing Image -->
                    <a href="/listings/<%= listing._id %>">
                        <img 
                            src="<%= listing.image.url %>" 
                            class="card-img-top listing-img" 
                            alt="<%= listing.title %>"
                        >
                    </a>

                    <!-- Card Content -->
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <!-- Title -->
                            <h5 class="card-title">
                                <%= listing.title %>
                            </h5>

                            <!-- Location -->
                            <p class="card-text text-muted mb-1">
                                <%= listing.location %>, <%= listing.country %>
                            </p>

                            <!-- Rating -->
                            <p class="card-text mb-1">
                                <i class="fa-solid fa-star text-warning"></i>
                                <span>4.8</span>
                            </p>

                            <!-- Price -->
                            <p class="card-text mb-3">
                                <b>₹<%= listing.price.toLocaleString("en-IN") %></b> / night
                            </p>
                        </div>

                        <!-- Delete Button -->
                        <div>
                            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    Delete
                                </button>
                            </form>
                        </div>

                    </div>

                </div>
            </div>
        <% } %>
    </div>
</div>